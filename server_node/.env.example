# server_node environment (gitignored — never commit real values)

# --- Required for the leaderboard / any DB route ---
# Your OWN test MongoDB Atlas connection string. Create a free test cluster and
# a DB user; do NOT reuse the production credentials.
dbUrl=

# JWT signing secret. Any string is fine for local dev; keep it private.
PVT_KEY=

# --- Optional: only needed for the mail routes (safe to leave blank for leaderboard dev) ---
# Gmail address + app password used by nodemailer. If blank you'll see a harmless
# "Missing credentials for PLAIN" log at startup; the server still runs.
email=
USER=
PASS=

# --- Optional: only needed for payment routes ---
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
